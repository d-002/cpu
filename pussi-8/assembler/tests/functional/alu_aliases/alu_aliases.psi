    or %r1,%r2,%r3
    nor %r1,%r2,%r3
    xor %r1,%r2,%r3
    xnor %r1,%r2,%r3
    and %r1,%r2,%r3
    nand %r1,%r2,%r3
    add %r1,%r2,%r3
    sub %r1,%r2,%r3
    mul %r1,%r2,%r3
    div %r1,%r2,%r3
    mod %r1,%r2,%r3

    ; binary warning
    mod %r1,%r2,%r0

    ; unary operations
    not %r1,%r2
    lsh %r1,%r2
    rsh %r1,%r2
    ror %r1,%r2
    rol %r1,%r2

    ; unary warning
    not %r1,%r0
